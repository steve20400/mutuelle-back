# Base de données PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=mutuelle_mobile
PGUSER=mutuelle_user
PGPASSWORD=changeme
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JWT
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRATION=9000000000
JWT_REFRESH_EXPIRATION=604800000

# SMTP (Gmail App Password — https://myaccount.google.com/apppasswords)
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password
